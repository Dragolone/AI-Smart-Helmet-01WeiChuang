# dependencies
node_modules/

# env & secrets
.env
.env.*
!.env.example

# build output
dist/
build/
out/

# expo / react native — 原生工程由 expo prebuild 生成，不进 Git（CNG 工作流）
.expo/
app/ios/
app/android/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# logs & caches
*.log
.cache/
coverage/

