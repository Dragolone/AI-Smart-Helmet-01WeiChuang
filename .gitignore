# dependencies
node_modules/

# env & secrets
.env
.env.*
!.env.example

# build output
dist/
build/
out/

# expo / react native — 原生工程由 expo prebuild 生成，不进 Git（CNG 工作流）
.expo/
app/ios/
app/android/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# logs & caches
*.log
.cache/
coverage/
coverage-e2e/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ts build cache
*.tsbuildinfo

# prisma 生成的客户端代码（prisma generate 产物，不进 Git）
backend/src/generated/

# prisma.config.ts 被编译器偶发误编译的杂散产物（见 docs/DEVELOPMENT.md 已知坑）
backend/prisma.config.js
backend/prisma.config.d.ts
backend/prisma.config.js.map
docs/testing/**/.admin.env
docs/testing/**/.devices.env

# Python 缓存（tools/ble-helmet-sim）
__pycache__/
*.pyc
app/modules/*/android/.gradle/
app/modules/*/android/build/

# iCloud 同步目录长出的「xxx 2.ext」杂散副本（审计 HYG-01/02）：不进 Git；仓库建议放非同步目录
* 2.*
* 2/

# 批量开通产物（provision:batch）：含 deviceSecret 的 CSV 与二维码，交接后销毁
backend/provision-out/
