generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS 工程按 CommonJS 编译；默认的 ESM 输出（含 import.meta）会在运行时崩溃
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  phone             String             @unique
  passwordHash      String             @map("password_hash")
  nickname          String?
  avatarUrl         String?            @map("avatar_url")
  createdAt         DateTime           @default(now()) @map("created_at")
  // 注销（App Store 要求应用内可注销）：软删除留档，phone 改写为 deleted:<id> 释放号码供再注册（原号不保留）
  deletedAt         DateTime?          @map("deleted_at")
  devices           Device[]
  refreshTokens     RefreshToken[]
  emergencyContacts EmergencyContact[]

  @@map("users")
}

// 紧急联系人（API.md §3）：SOS 超时/确认后的 SMS 通知对象，上限 5 个（活跃计数，定稿）
model EmergencyContact {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  name      String
  phone     String
  relation  String?
  createdAt DateTime  @default(now()) @map("created_at")
  // 软删除（Contract 要求）：已删联系人不占名额、不再接收通知；历史 SOS 通知记录留档不受影响
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@map("emergency_contacts")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  // 库中只存 sha256 哈希，明文只出现在下发响应里
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  // 轮换/登出即置位；已置位的 token 再次出现视为盗用信号
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// 短信验证码（注册 / 找回密码）。只存哈希；attempts 防在线穷举；同号同用途按 createdAt 取最新一条校验
model SmsCode {
  id         String    @id @default(cuid())
  phone      String
  purpose    String // register | reset_password
  codeHash   String    @map("code_hash")
  salt       String
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@map("sms_codes")
}

model Device {
  // 主键直接用硬件团队分配的 deviceId（如 helmet_001），不另造代理键
  deviceId         String    @id @map("device_id")
  deviceSecretHash String    @map("device_secret_hash")
  // 绑定码：出厂随附（真机形式待硬件确认，Mock/开通脚本生成同机制）
  bindCode         String?   @unique @map("bind_code")
  // 用户自定义设备名（绑定者可改；未设置时 App 显示 deviceId）
  name             String?
  bindUserId       String?   @map("bind_user_id")
  bindUser         User?     @relation(fields: [bindUserId], references: [id])
  boundAt          DateTime? @map("bound_at")
  // ↓ 状态快照：由 Ingest 收到设备事件时更新，App 的"在线/电量"数据源
  lastSeenAt       DateTime? @map("last_seen_at")
  battery          Int?
  charging         Boolean?
  signalLevel      Int?      @map("signal_level")
  sleeping         Boolean   @default(false)
  firmwareVersion  String?   @map("firmware_version")
  // 当前生效设置（API.md §8，口径 #27③）：只在命令 success 回执后写入——未回执绝不显示成功
  settings         Json?
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("devices")
}

// 绑定历史（决策 #39）：每段绑定关系一行；事件/轨迹/媒体的用户可见范围 = 该用户在该设备上的全部绑定区间
// （按服务端 receivedAt 判定）。换绑后新主看不到前主期间的数据；同一人解绑再绑回来，两段历史都可见。
// 不建外键：与 raw_events 同原则（用户/设备删除留档不受影响）
model DeviceBinding {
  id        String    @id @default(cuid())
  deviceId  String    @map("device_id")
  userId    String    @map("user_id")
  boundAt   DateTime  @default(now()) @map("bound_at")
  unboundAt DateTime? @map("unbound_at")

  @@index([deviceId, userId, boundAt])
  @@map("device_bindings")
}

// 设备命令（API.md §8 / DEVICE_PROTOCOL §7）：pending → delivered → success | failed | offline
// delivered = MQTT PUBACK（口径 #27④）；30s 无回执 → offline；迟到回执允许覆盖 offline（如实记录）
model DeviceCommand {
  id          String    @id @default(cuid())
  deviceId    String    @map("device_id")
  type        String // MVP: set_config（EVENTS.md §6，其他命令待硬件确认 ⚠️）
  params      Json
  status      String    @default("pending")
  issuedAt    DateTime  @default(now()) @map("issued_at")
  // 下发者（当时的绑定用户），审计留档
  issuedBy    String?   @map("issued_by")
  deliveredAt DateTime? @map("delivered_at")
  // 回执（cmd_ack）字段：result=success|failed；errorCode 码表待硬件（⚠️）
  ackResult   String?   @map("ack_result")
  errorCode   String?   @map("error_code")
  executedAt  DateTime? @map("executed_at")
  ackedAt     DateTime? @map("acked_at")

  @@index([deviceId, issuedAt])
  @@index([status, issuedAt])
  @@map("device_commands")
}

// 位置轨迹（API.md §5）：由 Ingest 从 location_update 事件写入，仅已注册设备；
// 类型化列（不用 raw_events 的 JSON payload）——轨迹查询是高频主路径，且为 Retention/降采样留余地
model LocationPoint {
  id               String   @id @default(cuid())
  // 与源事件 1:1（并发/重放的幂等兜底）；不建外键：与 raw_events 同原则
  eventId          String   @unique @map("event_id")
  deviceId         String   @map("device_id")
  // 设备侧事件发生时间；receivedAt 为服务器接收时间（时钟不可信时的兜底，见 DEVICE_PROTOCOL §8）
  timestamp        DateTime
  receivedAt       DateTime @default(now()) @map("received_at")
  latitude         Float
  longitude        Float
  // wgs84 | gcj02，随事件原样保存（EVENTS.md §2.4：坐标系不允许隐含）
  coordinateSystem String   @map("coordinate_system")
  accuracy         Float
  speed            Float
  heading          Float
  // 海拔（米）：滑雪场景的核心维度，设备未上报则为空
  altitude         Float?

  @@index([deviceId, timestamp])
  @@map("location_points")
}

// SOS 单 = 事故记录（API.md §7 一表两用）：possible_fall / manual_sos 触发，
// 服务端权威状态机（决策 #8）：pending → notified | cancelled，deadline 持久化 + 周期扫描 + 重启接管
model SosCase {
  id             String  @id @default(cuid())
  deviceId       String  @map("device_id")
  // 触发时的绑定用户，冗余固化：解绑后事故记录不失主；取消/确认权限与通知对象均以此为准
  userId         String  @map("user_id")
  // 与触发事件 1:1（幂等兜底）；不建外键：与 raw_events 同原则
  triggerEventId String  @unique @map("trigger_event_id")
  triggerType    String  @map("trigger_type") // possible_fall | manual_sos
  status         String  @default("pending") // pending | notified | cancelled
  // deadline 一律按服务器时间计算（createdAt + 倒计时秒数）；设备时钟不参与，clock_skew 不影响保命链路
  deadline       DateTime
  finalizedAt    DateTime? @map("finalized_at")
  // 事故位置快照（口径 2026-08-16 定稿）：优先触发事件 payload.location（逐字段校验），
  // 回落该设备最新轨迹点；都没有则为空但单照建。source: event | last_point
  latitude         Float?
  longitude        Float?
  coordinateSystem String? @map("coordinate_system")
  accuracy         Float?
  locationSource   String? @map("location_source")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  notifications  SosNotification[]

  // 附加约束（见 migration SQL）：partial unique index「每设备每用户至多一个 pending」
  //（决策 #40，2026-09-15；原为每设备一个），并发触发的兜底闸门（Prisma schema 语法不支持 partial index，故此处仅注释留痕）
  @@index([deviceId, createdAt])
  @@index([status, deadline])
  @@map("sos_cases")
}

// SOS 通知发送留档（Contract：成功/失败/通道必须可查；失败由扫描任务重试，超上限终态 failed）
model SosNotification {
  id          String    @id @default(cuid())
  sosId       String    @map("sos_id")
  sos         SosCase   @relation(fields: [sosId], references: [id])
  channel     String // sms | push
  // 发送目标（sms=联系人手机号原值，push=user:<id>）：留档历史事实，联系人事后改删不影响；日志侧脱敏
  target      String
  contactName String?   @map("contact_name")
  status      String    @default("pending") // pending | sent | failed
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([sosId])
  @@index([status])
  @@map("sos_notifications")
}

// 媒体元数据（API.md §9）：随 video_ready 事件入库；文件本体在对象存储（StorageProvider）。
// 上传方式待硬件确认（EVENTS.md 4.9 ⚠️）：storageKey 缺失时 status=pending_upload，不可换 URL
model Media {
  id             String   @id @default(cuid())
  // 与源 video_ready 事件 1:1（幂等兜底）；不建外键：与 raw_events 同原则
  eventId        String   @unique @map("event_id")
  deviceId       String   @map("device_id")
  // 设备侧媒体唯一 ID：同设备内唯一（跨设备可能重复，故用复合唯一约束）
  videoId        String   @map("video_id")
  // 关联的危险/摔倒事件 eventId（§6 详情的 media 数组据此反查）
  relatedEventId String?  @map("related_event_id")
  // 秒（EVENTS.md 4.9）
  duration       Int?
  // 视频可超 2GB：int4 会溢出让整条媒体元数据丢失
  sizeBytes      BigInt?  @map("size_bytes")
  storageKey     String?  @map("storage_key")
  status         String   @default("ready") // ready | pending_upload
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([deviceId, videoId])
  @@index([relatedEventId])
  @@map("media")
}

// 管理员与 App 用户完全分离（API.md §10）：种子脚本创建，不做自助注册
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// 对讲频道（API.md §13，口径 #27⑤）：TRTC 房间号=数字 roomId（自增，TRTC 要求 uint32）；
// 6 位邀请码加入；后端只管频道与凭证，音频流走 App ↔ TRTC 云，不经后端
model VoiceChannel {
  id         String               @id @default(cuid())
  name       String
  roomId     Int                  @unique @default(autoincrement()) @map("room_id")
  inviteCode String               @unique @map("invite_code")
  ownerId    String               @map("owner_id")
  createdAt  DateTime             @default(now()) @map("created_at")
  members    VoiceChannelMember[]

  @@map("voice_channels")
}

model VoiceChannelMember {
  id        String       @id @default(cuid())
  channelId String       @map("channel_id")
  channel   VoiceChannel @relation(fields: [channelId], references: [id])
  userId    String       @map("user_id")
  joinedAt  DateTime     @default(now()) @map("joined_at")

  // 重复加入幂等的数据库级兜底
  @@unique([channelId, userId])
  @@index([userId])
  @@map("voice_channel_members")
}

model RawEvent {
  id              String   @id @default(cuid())
  // 幂等去重依据：设备/算法侧生成的 eventId，唯一约束兜底并发重复
  eventId         String   @unique @map("event_id")
  // 故意不建到 devices 的外键：未注册设备/未知来源的事件也必须能原样落库（Ingest 层规则）
  deviceId        String   @map("device_id")
  eventType       String   @map("event_type")
  timestamp       DateTime
  receivedAt      DateTime @default(now()) @map("received_at")
  schemaVersion   Int      @map("schema_version")
  firmwareVersion String?  @map("firmware_version")
  payload         Json
  // 事件入口（mqtt/webhook）：仅供排查，业务模块不可见不可依赖（EVENTS.md §1）
  source          String   @default("mqtt")
  // 设备时钟偏移标记：|timestamp - receivedAt| 超阈值时置真（DEVICE_PROTOCOL §8）
  clockSkew       Boolean  @default(false) @map("clock_skew")

  @@index([deviceId, timestamp])
  @@map("raw_events")
}
