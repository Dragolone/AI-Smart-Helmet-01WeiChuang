# 本地开发：按 docker-compose.yml 里 postgres 的凭证组装
# 格式：postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=

# MQTT Broker（本地为 docker-compose 里的 EMQX，明文 1883 仅限本地）
MQTT_URL=mqtt://localhost:1883
# 后端消费者的固定 MQTT clientId（配合持久会话；单实例部署下保持默认即可）
MQTT_BACKEND_CLIENT_ID=backend_ingest

# JWT 签名密钥（本地随便生成；development/production 必须用强随机值且不入库）
JWT_SECRET=

# 管理后台 JWT 密钥：必须与 JWT_SECRET 不同值（密钥隔离，admin/用户 token 互不可用）
ADMIN_JWT_SECRET=

# EMQX 认证体系（emqx/emqx.conf 引用；云端环境全部换强随机值）
EMQX_INTERNAL_TOKEN=
MQTT_BACKEND_USERNAME=backend_ingest
MQTT_BACKEND_PASSWORD=

# SOS 状态机（缺省即产品口径，本地一般不用改；测试用短倒计时跑全路径）
# SOS_COUNTDOWN_SECONDS=60
# SOS_SCAN_INTERVAL_MS=5000
# SOS_NOTIFY_MAX_ATTEMPTS=3

# 媒体预签名 URL 时效（API.md §9 定稿 10 分钟）
# MEDIA_URL_TTL_SECONDS=600

# 命令状态机（DEVICE_PROTOCOL §7）：回执超时 30s → offline（口径 #27④）
# COMMAND_ACK_TIMEOUT_SECONDS=30
# COMMAND_SCAN_INTERVAL_MS=5000

# 对讲（API.md §13）：TRTC 个人测试应用的 SDKAppID/SecretKey（问 Developer A 要 Week 2 Spike 那套）
# 未配置时频道功能可用，进房凭证接口返回 503 TRTC_NOT_CONFIGURED
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
# TRTC_SIG_EXPIRE_SECONDS=86400
# VOICE_CHANNEL_MEMBER_LIMIT=20
