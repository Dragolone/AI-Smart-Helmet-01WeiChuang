{
  "expo": {
    "name": "零一唯创",
    "slug": "app",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-brand.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lingyiweichuang.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "用于队友间的实时语音对讲。",
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "iosamap"
        ],
        "NSLocalNetworkUsageDescription": "用于连接智能头盔的 Wi-Fi 热点，查看头盔摄像头的实时画面。",
        "NSPhotoLibraryAddUsageDescription": "用于把头盔实时画面的截图保存到您的相册。",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true,
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "appleTeamId": "B3NHB45FS7"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-android-fg.png",
        "backgroundImage": "./assets/images/icon-android-bg.png",
        "monochromeImage": "./assets/images/icon-android-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lingyiweichuang.app",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.GET_TASKS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于在地图上显示您的位置、记录骑行轨迹以及在紧急情况下发送您的位置。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F12",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 64
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "networkInspector": false
          },
          "android": {
            "networkInspector": false,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "用于扫描头盔上的二维码完成绑定。",
          "microphonePermission": "用于队友间的实时语音对讲。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择照片设置您的头像。"
        }
      ],
      "expo-audio",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "用于连接您的智能头盔,接收摔倒检测与危险预警等安全事件(即使 App 在后台)。"
        }
      ],
      "./plugins/with-jpush.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "jpush": {
        "appKey": "79cce150234ce38063213ccd",
        "channel": "official",
        "xiaomi": {
          "appId": "2882303761520592446",
          "appKey": "5922059287446"
        }
      }
    }
  }
}
