{
  "expo": {
    "name": "零一唯创",
    "slug": "app",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-brand.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.lingyiweichuang.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "用于队友间的实时语音对讲。",
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "iosamap"
        ]
      },
      "appleTeamId": "LZ3H94F5LC"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/images/splash-brand.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lingyiweichuang.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于在地图上显示您的位置、记录骑行轨迹以及在紧急情况下发送您的位置。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F12",
          "image": "./assets/images/splash-brand.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "networkInspector": false
          },
          "android": {
            "networkInspector": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "用于扫描头盔上的二维码完成绑定。",
          "microphonePermission": "用于队友间的实时语音对讲。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择照片设置您的头像。"
        }
      ],
      "expo-audio",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "用于连接您的智能头盔,接收摔倒检测与危险预警等安全事件(即使 App 在后台)。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
