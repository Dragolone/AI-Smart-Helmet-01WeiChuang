# 复制为 .env 后填入真实值；.env 不进 Git（CLAUDE.md 环境变量规则）

# TRTC Spike 专用（仅本地开发；正式环境 UserSig 由后端签发，SecretKey 绝不进客户端）
EXPO_PUBLIC_TRTC_SDKAPPID=
EXPO_PUBLIC_TRTC_SECRETKEY=

# 真机联调：填 Mac 局域网 IP（真机上 localhost 是手机自己）
EXPO_PUBLIC_API_URL=http://<mac-lan-ip>:3000/api/v1

# 高德地图 Key（lbs.amap.com 控制台「AI头盔」应用下按平台创建）
EXPO_PUBLIC_AMAP_ANDROID_KEY=
EXPO_PUBLIC_AMAP_IOS_KEY=
# Web端(JS API) Key 及其配套安全密钥（WebView 路线用）
EXPO_PUBLIC_AMAP_JS_KEY=
EXPO_PUBLIC_AMAP_JS_SECURITY_CODE=
