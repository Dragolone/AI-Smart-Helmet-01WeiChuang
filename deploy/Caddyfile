# 网关配置：域名与邮箱来自 compose 注入的环境变量（deploy/.env）
# 证书由 Caddy 自动向 Let's Encrypt 申请并续期（决策 #34 讨论定案：MVP 用自动签发，
# 若国内网络申请超时，可退回手动模式——tls /certs/cert.pem /certs/key.pem 挂腾讯云证书，见 DEPLOYMENT.md 排障）
{
	email {$ACME_EMAIL}
}

# App 的 REST + WebSocket 入口（wss 由 Caddy 透明代理，App 端 https→wss 自动推导）
{$API_DOMAIN} {
	# 轨迹、事件列表都是几十到几百 KB 的 JSON，gzip 后约 1/5（10-31 实测 1000 点轨迹 195→35 KB）；只开 gzip：zstd 只再小 0.1%，
	# 没必要让安卓多走一条解压路径。WebSocket 升级请求 Caddy 不编码；不足 512 字节不压
	encode gzip

	# handle 块互斥、按路径长度最长优先（与下方 admin 块同一写法）
	# EMQX 认证/授权回调只走容器网络 backend:3000（DEVICE_PROTOCOL §3.1），公网一律 404（审计 MQTT-03）；
	# 后端 InternalTokenGuard 仍是第二层
	handle /api/v1/internal/* {
		respond 404
	}

	# 隐私政策与用户协议：静态页，不经后端。极光「隐私协议」字段、App 备案、双端商店上架都要一个公开 URL。
	# handle 只收一个匹配符，写两个会「wrong argument count」启动失败（2026-09-23 踩过，网关崩了 10 分钟）；
	# 对外只发布 /legal/privacy 与 /legal/terms 两个地址，不支持不带子路径的 /legal
	handle /legal/* {
		root * /srv
		try_files {path} {path}.html
		file_server
		header Cache-Control "public, max-age=300"
	}

	handle {
		reverse_proxy backend:3000 {
			# 显式用真实客户端 IP 覆写 X-Forwarded-For，不依赖 Caddy 默认的 trusted_proxies 行为；
			# 后端 TRUST_PROXY=1 只信这一跳（审计 AUTH-07）
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# 管理后台：/api 同源转发给后端（与本地 vite proxy 同职责），其余走 SPA 静态文件
{$ADMIN_DOMAIN} {
	encode gzip

	# handle 块按路径长度排序、最长优先：/api/v1/internal/* 先于 /api/* 命中，公网一律 404（审计 MQTT-03）
	handle /api/v1/internal/* {
		respond 404
	}
	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
