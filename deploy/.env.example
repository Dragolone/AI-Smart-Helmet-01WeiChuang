# 生产/联调环境变量清单 —— 复制为 deploy/.env 后填值；.env 不进 Git（CLAUDE.md 规则）
# 所有「强随机」值用：openssl rand -hex 32   （每个键独立生成，禁止复用同一个值）

# ── 生产开关：转正式环境当天设为 1 ──
# 任一通道（短信 / 推送 / 对象存储）配置不全时拒绝启动，而不是静默回落 Mock：Mock 短信「发送成功」与真发
# 在通知记录和本人推送文案里完全分不出来，漏填一项 TENCENT_SMS_* 就等于每次真求救都「已通知」却一条没发。
# development 留空（审核期就是要用 Mock 联调）。
REQUIRE_REAL_PROVIDERS=
# 开关类变量（REQUIRE_REAL_PROVIDERS / JPUSH_APNS_PRODUCTION）认 1 / true / yes / on 与 0 / false / no / off / 空，
# 不分大小写；写成别的值后端拒绝启动（原来写错会静默当成关）

# ── 域名（决策 #34：01weichuang.com 子域名，备案复用，DNS A 记录先解析到服务器）──
API_DOMAIN=dev-api.01weichuang.com
ADMIN_DOMAIN=dev-admin.01weichuang.com

# ── 后端进程（compose 已透传，留空走默认）──
# backend 前面有几层反向代理（只经 Caddy 一跳就是 1；限频按客户端 IP 计，依赖它取到真 IP）
# TRUST_PROXY=1
# 收到 SIGTERM 后 /health 先回 503 排空这么久再关闭（毫秒，默认 3000；要小于 compose 的 stop_grace_period 15s）
# SHUTDOWN_DRAIN_MS=3000
# 发验证码短信的单次超时（毫秒，默认 10000）
# SMS_SEND_TIMEOUT_MS=10000
# Let's Encrypt 证书到期/异常的通知邮箱
ACME_EMAIL=

# ── 数据库（用户/库名固定 helmet，与 backend 的 DATABASE_URL 由 compose 拼装）──
POSTGRES_PASSWORD=

# ── JWT（两把必须不同值：admin/用户 token 互不可用，API.md §10）──
JWT_SECRET=
ADMIN_JWT_SECRET=

# ── EMQX ──
# 后端内部回调令牌（渲染进 generated/emqx.conf，改动后须重跑 render-config.sh 并重启 emqx）
EMQX_INTERNAL_TOKEN=
# 后端 MQTT 消费者自身凭证（用户名默认 backend_ingest，与本地机制一致）
MQTT_BACKEND_USERNAME=backend_ingest
MQTT_BACKEND_PASSWORD=
# Erlang 节点 cookie 与 Dashboard 密码（Dashboard 仅 SSH 隧道可达，密码仍必须改）
EMQX_NODE_COOKIE=
EMQX_DASHBOARD_PASSWORD=

# ── 算法服务 Webhook（API.md §12）：云端算法服务未接入前留空即可（入口拒绝所有请求，不影响其余功能）──
INGEST_WEBHOOK_API_KEY=

# ── 对讲（API.md §13）：当前为 TRTC 个人测试应用，公司正式应用就绪后换值即可，零代码改动 ──
# 留空不影响其余功能，仅进房凭证接口返回 503 TRTC_NOT_CONFIGURED
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# ── 短信通道 ──
# 短信通道（决策 #34 腾讯云）。六项齐全即真发；任一为空走 Console Mock（验证码打印在日志）
# 取值见 docs/THIRD_PARTY.md §4：子账号 API 密钥、短信应用 SdkAppId、审核通过的签名与两个模板 ID
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_VERIFY_CODE=
TENCENT_SMS_TEMPLATE_SOS_ALERT=
# TENCENT_SMS_REGION=ap-guangzhou
# 验证码口径（API.md §2；留空即默认）
# SMS_CODE_TTL_SECONDS=300

# ── 推送通道（决策 #10 极光）──
# AppKey + Master Secret 齐全即真推（按 alias=userId 定向，App 登录后 setAlias）；任一为空走 Console Mock
# 取值见 docs/THIRD_PARTY.md §6；Master Secret 只在密码库与服务器 .env，绝不进 App
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# iOS 走 APNs 生产环境（TestFlight/App Store 包）填 true；Xcode 直装的开发包留空/false
# JPUSH_APNS_PRODUCTION=
# 厂商通道参数（极光 options.third_party_channel，JSON 原样透传）：App 被杀后 Android 只能靠华为 / 小米等厂商通道送达，
# 而厂商按消息分类限流，SOS 要登记成提醒类 / 系统级消息才不被当营销消息压掉。各家键名不同，厂商后台申请到什么填什么，例：
# JPUSH_THIRD_PARTY_CHANNEL={"huawei":{"distribution":"secondary_push","importance":"NORMAL","category":"DEVICE_REMINDER"},"xiaomi":{"distribution":"secondary_push","channel_id":"<小米后台申请的 channel>"}}
# JPUSH_THIRD_PARTY_CHANNEL=
# 单次推送调用超时（毫秒，默认 10000）
# PUSH_SEND_TIMEOUT_MS=
# SMS_CODE_RESEND_INTERVAL_SECONDS=60
# SMS_CODE_DAILY_LIMIT=10
# SMS_CODE_MAX_ATTEMPTS=5

# ── 对象存储 ──
# 腾讯云 COS（决策 #34）。密钥与桶名齐全即签发真实链接；任一为空走 Mock（占位 URL，不可访问）
# 子账号只授 QcloudCOSDataFullControl，桶私有读写；取值见 docs/THIRD_PARTY.md §3
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=ap-guangzhou
# 数据库备份桶（2026-10-14）：与媒体桶分开——媒体换链接接口按设备上报的路径签名，同桶等于给设备一条通往整库导出的路。
# 控制台新建一个私有桶填这里（子账号 helmet-cos 的 QcloudCOSDataFullControl 对全账号的桶都有效，不用另授权）；
# 留空则备份落到媒体桶并在备份日志里打 ⚠️。备份桶必须与媒体桶同地域（上传沿用 TENCENT_COS_REGION，异地会上传失败、退出码 1）
TENCENT_COS_BACKUP_BUCKET=

# ── 演示常驻 Mock 头盔（compose 服务 mock，profile demo）──
# 步骤：§3 用 provision:device 开通一台设备 → 把 deviceId/deviceSecret 填到下面 → 把 COMPOSE_PROFILES=demo 的注释去掉 → up -d --build
# 之后日常 up/restart/logs 命令都会带上 mock；不想常驻就把 COMPOSE_PROFILES 注释回去并 docker compose ... rm -sf mock
#COMPOSE_PROFILES=demo
MOCK_DEVICE_ID=
MOCK_DEVICE_SECRET=
# 剧本（留空=正常骑行）：ski / fall / sos / risk / tour（全情况轮播，每轮一次求救会真发短信）；位置间隔 ms（默认 10000）；命令回执三态 success|failed|silent
MOCK_SCENARIO=
MOCK_LOCATION_INTERVAL_MS=10000
MOCK_CMD_RESULT=success
# 第二顶常驻 Mock（profile demo2，真机多设备回归用）：再开一台设备填这里，COMPOSE_PROFILES 写成 demo,demo2
MOCK2_DEVICE_ID=
MOCK2_DEVICE_SECRET=
MOCK2_SCENARIO=
MOCK2_LOCATION_INTERVAL_MS=10000
MOCK2_CMD_RESULT=success
# 第三顶常驻 Mock（profile demo3，汤总体验用）：再开一台设备填这里，COMPOSE_PROFILES 写成 demo,demo2,demo3。
# 剧本留空（riding）；别填 fall / sos，会周期性真发求救短信
MOCK3_DEVICE_ID=
MOCK3_DEVICE_SECRET=
MOCK3_SCENARIO=
MOCK3_LOCATION_INTERVAL_MS=10000
MOCK3_CMD_RESULT=success
# 第四顶常驻 Mock（profile demo4，负责人自测用）：剧本 tour（默认）——一轮 72 个位置点（12 分钟）演 8 条各不相同的安全事件
# （4 条带录像）+ 摔倒或求救 + 休眠→唤醒 + 蓝牙断开。⚠️ 每轮一次求救，到期未取消会真发短信（dev 短信 10-12 起已真发），只绑自测账号；
# 账号里有真实联系人就把 MOCK4_TOUR_SOS 改成 0（只关求救那一步，其余照演）。MOCK4_TOUR_CYCLE_POINTS 可改轮长（≥40 个点，留空=72）。
# COMPOSE_PROFILES 写成 demo,demo2,demo3,demo4
MOCK4_DEVICE_ID=
MOCK4_DEVICE_SECRET=
MOCK4_SCENARIO=tour
MOCK4_TOUR_CYCLE_POINTS=
MOCK4_TOUR_SOS=1
# 第五、六顶常驻 Mock（profile demo5 / demo6，负责人看多头盔界面用）：剧本留空（riding），别设 fall / sos。COMPOSE_PROFILES 里加 demo5,demo6
MOCK5_DEVICE_ID=
MOCK5_DEVICE_SECRET=
MOCK5_SCENARIO=
MOCK5_LOCATION_INTERVAL_MS=10000
MOCK5_CMD_RESULT=success
MOCK6_DEVICE_ID=
MOCK6_DEVICE_SECRET=
MOCK6_SCENARIO=
MOCK6_LOCATION_INTERVAL_MS=10000
MOCK6_CMD_RESULT=success
MOCK4_LOCATION_INTERVAL_MS=10000
MOCK4_CMD_RESULT=success

# ── 可调业务参数（全部选填：留空/删除即用代码内默认值）──
# 改这里的值需要 docker compose up -d 重建 backend 容器才生效。
# SOS 倒计时秒数（产品口径 60s，决策 #28 对外表述以此为准；改动前先与负责人确认）
SOS_COUNTDOWN_SECONDS=60
# SOS 到期扫描间隔（ms，决策 #8：持久化 deadline + 周期扫描）
SOS_SCAN_INTERVAL_MS=5000
# 单条通知最大投递次数（含首次），到上限终态 failed 留档（决策 #50：5 次）
SOS_NOTIFY_MAX_ATTEMPTS=5
# 相邻两次投递之间的等待（秒，逗号分隔）；留空 = 默认 10,60,300,900，连首次 5 次约 21 分钟用完
SOS_NOTIFY_RETRY_DELAYS_SECONDS=
# SOS 漏单对账间隔（秒，决策 #51）；留空 = 默认 60
SOS_RECONCILE_INTERVAL_SECONDS=
# 命令无回执判 offline 的超时（秒，口径 #27④：真机联调若硬件有更准口径就调这里）
COMMAND_ACK_TIMEOUT_SECONDS=30
COMMAND_SCAN_INTERVAL_MS=5000
# 媒体预签名 URL 有效期（秒，定稿 10min）
MEDIA_URL_TTL_SECONDS=600
# TRTC UserSig 有效期（秒）与频道成员上限（口径 #27⑤：20）
TRTC_SIG_EXPIRE_SECONDS=86400
# 房间权限钥匙（PrivateMapKey）有效期（秒，决策 #56）：只在进房那一刻校验，App 进房前现取，默认 10 分钟
TRTC_ROOM_KEY_EXPIRE_SECONDS=600
VOICE_CHANNEL_MEMBER_LIMIT=20
